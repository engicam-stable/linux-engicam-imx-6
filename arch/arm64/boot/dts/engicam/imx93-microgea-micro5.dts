&gpio4 {
	status="okay";
	pinctrl-names = "default";
    pinctrl-0 = <&pinctrl_lcd_rst>;
	gpio-line-names =
		"", "", "", "", "", "", "", "",
		"", "", "", "", "", "AUDIO_SD#", "", "",
		"", "LCD_nRST", "", "", "", "", "", "",
		"", "", "", "", "", "", "", "";
		
		LCD_nRST { /*DISPLAY - Reset*/
			gpio-hog;
			gpios = <17 GPIO_ACTIVE_HIGH>;
			output-high;
			line-name = "lcd-reset";
		};
		
