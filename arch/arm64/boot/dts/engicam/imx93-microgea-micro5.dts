/dts-v1/;

#include <dt-bindings/net/mxl-8611x.h>
#include <dt-bindings/usb/pd.h>
#include "../freescale/imx93.dtsi"

&ele_fw2 { /*Needed for clean reboot*/
	memory-region = <&ele_reserved>;
};

/ {
	model = "NXP i.MX93 microgea Micro 5 - rev 1651A \n";
	compatible = "engi,imx93" ,"fsl,imx93";

	aliases {
		rtc1= &bbnsm_rtc;
	};

	chosen {
		stdout-path = &lpuart1;
	};

	ethosu { /*NPU*/
		compatible = "arm,ethosu";
		fsl,cm33-proc = <&cm33>;
		memory-region = <&ethosu_mem>;
		power-domains = <&mlmix>;
	};
	
	backlight: backlight { /*DISPLAY - Backlight*/
		compatible = "pwm-backlight";
		pwms = <&tpm2 0 100000 0>;
		brightness-levels = <0 100>;
		num-interpolated-steps = <100>;
		default-brightness-level = <80>;
	};
	
	panel { /*DISPLAY - Display logic*/
		compatible = "winstar,wf50ftwagdng0";
		backlight = <&backlight>;
		power-supply = <&reg_display_pwr>;
		status = "okay";

		port {
			panel_in: endpoint {
				remote-endpoint = <&display_out>;
			};
		};
	};

	reg_display_pwr: regulator-display-pwr { /*DISPLAY - Power*/
		compatible = "regulator-fixed";
		regulator-name = "display_pwr";
		gpio = <&gpio2 25 GPIO_ACTIVE_HIGH>;
		enable-active-high;
		regulator-boot-on;
		regulator-always-on; /* Remove this if you want the driver to manage it */
	};
	
	wifi_pwrseq: wifi-pwrseq { /*WIFI/BT WL_REG_ON*/
        compatible = "mmc-pwrseq-simple";
        reset-gpios = <&pcal6416 9 GPIO_ACTIVE_LOW>; /*EXPIO_1_1*/
        post-power-on-delay-ms = <500>;
    };

	reg_3v3_aux: regulator-3v3aux { /*WIFI/BT - Regulator*/
		compatible = "regulator-gpio";
		regulator-name = "3v3_aux";
		regulator-min-microvolt = <3300000>;
		regulator-max-microvolt = <3300000>;
		states = <3300000 0x1>,
				 <3300000 0x0>;
		enable-active-high;
	};

	reserved-memory {
		#address-cells = <2>;
		#size-cells = <2>;
		ranges;

		linux,cma {
			compatible = "shared-dma-pool";
			reusable;
			alloc-ranges = <0 0x80000000 0 0x40000000>;
			size = <0 0x10000000>;
			linux,cma-default;
		};

		ethosu_mem: ethosu_region@C0000000 {
			compatible = "shared-dma-pool";
			reusable;
			reg = <0x0 0xC0000000 0x0 0x10000000>;
		};

		rsc_table: rsc-table@2021e000 {
			reg = <0 0x2021e000 0 0x1000>;
			no-map;
		};

		vdevbuffer: vdevbuffer@a4020000 {
			compatible = "shared-dma-pool";
			reg = <0 0xa4020000 0 0x100000>;
			no-map;
		};

		vdev0vring0: vdev0vring0@a4000000 {
			reg = <0 0xa4000000 0 0x8000>;
			no-map;
		};

		vdev0vring1: vdev0vring1@a4008000 {
			reg = <0 0xa4008000 0 0x8000>;
			no-map;
		};

		vdev1vring0: vdev1vring0@a4000000 {
			reg = <0 0xa4010000 0 0x8000>;
			no-map;
		};

		vdev1vring1: vdev1vring1@a4018000 {
			reg = <0 0xa4018000 0 0x8000>;
			no-map;
		};

		ele_reserved: ele-reserved@a4120000 {
			compatible = "shared-dma-pool";
			reg = <0 0xa4120000 0 0x100000>;
			no-map;
		};
	};

	sound { /*SOUND*/
		compatible = "simple-audio-card";
		simple-audio-card,name = "tas2780-audio";
		simple-audio-card,format = "i2s";
		simple-audio-card,bitclock-master = <&dailink_master1>;
		simple-audio-card,frame-master = <&dailink_master1>;

		dailink_master1: simple-audio-card,cpu {
			sound-dai = <&sai2>;
		};

		simple-audio-card,codec {
			sound-dai = <&tas2780>;
		};
	};
};

&tpm2 { /*DISPALY - Backlight PWM*/
	pinctrl-names = "default";
	pinctrl-0 = <&pinctrl_tpm2_ch0>;
	status = "okay";
};

&parallel_disp_fmt { /*DISPLAY - Display bridge*/
	pinctrl-names = "default";
	pinctrl-0 = <&pinctrl_lcdif>;
	fsl,interface-pix-fmt = "rgb888";
	status = "okay";

	ports {
		port@1 {
			reg = <1>;
			display_out: endpoint {
				remote-endpoint = <&panel_in>;
			};
		};
	};
};

&cm33 { /*NPU*/
	mbox-names = "tx", "rx", "rxdb";
	mboxes = <&mu1 0 1
		&mu1 1 1
		&mu1 3 1>;
	memory-region = <&vdevbuffer>, <&vdev0vring0>, <&vdev0vring1>,
			<&vdev1vring0>, <&vdev1vring1>, <&rsc_table>;
	fsl,startup-delay-ms = <500>;
	status = "okay";
};

&eqos { /*ETHERNET*/
	pinctrl-names = "default";
	pinctrl-0 = <&pinctrl_eqos>;
	phy-mode = "rmii";
	phy-handle = <&ethphy0>;
	snps,rmii_refclk_ext;
	status = "okay";

	mdio {
		compatible = "snps,dwmac-mdio";
		#address-cells = <1>;
		#size-cells = <0>;
		clock-frequency = <5000000>;

		ethphy0: ethernet-phy@0 {
			reg = <0>;
		};
	};
};

&epxp { /*DISPLAY - Hardware accelerator*/
	status = "okay";
};

&flexcan1 { /*CAN*/
	pinctrl-names = "default";
	pinctrl-0 = <&pinctrl_flexcan1>;
	fsl,stop-mode = <&aonmix_ns_gpr 0x10 4>;
	status = "okay";
};

&lcdif { /*DIPLAY - Display Controller, Pixel Clock/DMA*/
	assigned-clock-rates = <300000000>, <30000000>, <400000000>, <133333333>;
	status = "okay";
};

&media_blk_ctrl { /*DISPLAY - Video Power*/
	status = "okay";
};

&lpi2c2 { /*I2C2 - PMIC*/
	#address-cells = <1>;
	#size-cells = <0>;
	clock-frequency = <400000>;
	pinctrl-names = "default", "sleep";
	pinctrl-0 = <&pinctrl_lpi2c2>;
	pinctrl-1 = <&pinctrl_lpi2c2>;
	status = "okay";

	pmic@32 { /*PMIC*/
		compatible = "nxp,pf9453";
		pinctrl-names = "default";
		pinctrl-0 = <&pinctrl_pf9453>;
		reg = <0x32>;
		interrupt-parent = <&gpio3>;
		interrupts = <7 IRQ_TYPE_EDGE_FALLING>;

		regulators {
			buck1: BUCK1 {
				regulator-name = "BUCK1";
				regulator-min-microvolt = <600000>;
				regulator-max-microvolt = <3775000>;
				regulator-boot-on;
				regulator-always-on;
			};

			buck2: BUCK2 {
				regulator-name = "BUCK2";
				regulator-min-microvolt = <600000>;
				regulator-max-microvolt = <2187500>;
				regulator-boot-on;
				regulator-always-on;
				regulator-ramp-delay = <12500>;
			};

			buck3: BUCK3 {
				regulator-name = "BUCK3";
				regulator-min-microvolt = <600000>;
				regulator-max-microvolt = <3775000>;
				regulator-boot-on;
				regulator-always-on;
			};

			buck4: BUCK4{
				regulator-name = "BUCK4";
				regulator-min-microvolt = <600000>;
				regulator-max-microvolt = <3775000>;
				regulator-boot-on;
				regulator-always-on;
			};

			ldo1: LDO1 {
				regulator-name = "LDO1";
				regulator-min-microvolt = <800000>;
				regulator-max-microvolt = <3300000>;
				regulator-boot-on;
				regulator-always-on;
			};

			ldo_snvs: LDO_SNVS {
				regulator-name = "LDO_SNVS";
				regulator-min-microvolt = <1200000>;
				regulator-max-microvolt = <3400000>;
				regulator-boot-on;
				regulator-always-on;
			};
		};
	};

	pcal6416: gpio@20 { /*EXPANSION GPIO - Wifi*/
		compatible = "nxp,pcal6416";
		pinctrl-names = "default";
		pinctrl-0 = <&pinctrl_pcal6416>;
		reg = <0x20>;
		interrupt-parent = <&gpio4>;
		interrupts = <27 IRQ_TYPE_LEVEL_LOW>;
		interrupt-controller;
		#interrupt-cells = <2>;
		gpio-controller;
		#gpio-cells = <2>;
		gpio-line-names =
			"EXPIO_0_0", "EXPIO_0_1", "EXPIO_0_2", "EXPIO_0_3",
			"EXPIO_0_4", "EXPIO_0_5", "EXPIO_0_6", "EXPIO_0_7",
			"EXPIO_1_0", "EXPIO_1_1", "EXPIO_1_2", "EXPIO_1_3",
			"EXPIO_1_4", "EXPIO_1_5", "EXPIO_1_6", "EXPIO_1_7";
	};
		
};

&lpi2c3 { /*I2C3 - Touchscreen Sound rtc*/
	#address-cells = <1>;
	#size-cells = <0>;
	clock-frequency = <400000>;
	pinctrl-names = "default";
	pinctrl-0 = <&pinctrl_lpi2c3>;
	status = "okay";

	touchscreen@41 { /*TOUCHSCREEN*/
		compatible = "ilitek,ili2130";
		pinctrl-0 = <&pinctrl_ilitek>;
		reg = <0x41>;
		interrupt-parent = <&gpio4>; /*LCD_TP_nINT*/
		interrupts = <23 IRQ_TYPE_LEVEL_LOW>;
		reset-gpios = <&gpio4 12 GPIO_ACTIVE_LOW>; /*LCD_TP_nRST*/
	};

	pcf8523: rtc@68 { /*RTC*/
		compatible = "nxp,pcf8523";
		reg = <0x68>;
	};

	tas2780: codec@3d { /*SOUND*/
		compatible = "ti,tas2780";
		reg = <0x3d>;
		pinctrl-names = "default";
		pinctrl-0 = <&pinctrl_tas2780_reset>;
		#sound-dai-cells = <0>;
		reset-gpios = <&gpio4 13 0>;
		shutdown-gpios = <&gpio4 13 0>;
		ti,imon-slot-no = <0>;
		ti,vmon-slot-no = <2>;
	};

	//eeprom@53 {
	//	compatible = "atmel,24c64";
	//	reg = <0x53>;
	//	pagesize = <64>;
	//};
};

&lpuart1 { /*CONSOLE*/
	pinctrl-names = "default";
	pinctrl-0 = <&pinctrl_uart1>;
	status = "okay";
};

&lpuart2 { /* RS 232 */
	pinctrl-names = "default";
	pinctrl-0 = <&pinctrl_uart2>;
	status = "okay";
};

&lpuart4 { /* BT */
	pinctrl-names = "default";
	pinctrl-0 = <&pinctrl_uart4>;
	status = "okay";
};

&lpuart5 { /* RS 485 */
	pinctrl-names = "default";
	pinctrl-0 = <&pinctrl_uart5>;
	status = "okay";
};

&lpspi1 { /*SPI MISO/MOSI*/
	fsl,spi-num-chipselects = <1>;
	pinctrl-names = "default";
	pinctrl-0 = <&pinctrl_lpspi1>;
	cs-gpios = <&gpio1 11 GPIO_ACTIVE_LOW>;
	pinctrl-assert-gpios = <&gpio4 2 GPIO_ACTIVE_HIGH>;
	status = "okay";
	/delete-property/ dmas;
	/delete-property/ dma-names;

	tpm0: slb9670@0 {
		reg = <0>;
		compatible = "infineon,slb9670";
		spi-max-frequency = <1000000>;
	};
};

&sai2 { /*SAI2 - Sounds*/
	#sound-dai-cells = <0>;
	pinctrl-names = "default", "sleep";
	pinctrl-0 = <&pinctrl_sai2>;
	pinctrl-1 = <&pinctrl_sai2_sleep>;
	assigned-clocks = <&clk IMX93_CLK_SAI2>;
	assigned-clock-parents = <&clk IMX93_CLK_AUDIO_PLL>;
	assigned-clock-rates = <12288000>;
	fsl,sai-mclk-direction-output;
	status = "okay";
};

&usbotg1 { /*USB J3*/
	dr_mode = "OTG";
	status = "okay";
};

&usbotg2 { /*USB J9*/
	dr_mode = "host";
	status = "okay";
};

&usdhc1 { /*EMMC*/
	pinctrl-names = "default";
	pinctrl-0 = <&pinctrl_usdhc1>;
	bus-width = <8>;
	no-1-8-v;
	no-mmc-hs400;
	non-removable;
	status = "okay";
};

&usdhc2 { /*SD CARD*/
	pinctrl-names = "default";
	pinctrl-0 = <&pinctrl_usdhc2>;
	bus-width = <4>;
	
	no-1-8-v;
	broken-cd;
	max-frequency = <25000000>;
	
	non-removable;
	status = "okay";
};

&usdhc3 { /*WIFI*/
	pinctrl-names = "default";
	pinctrl-0 = <&pinctrl_usdhc3>; //pinctrl_panasonic
	bus-width = <4>;
	vmmc-supply = <&reg_3v3_aux>;
	mmc-pwrseq = <&wifi_pwrseq>;
	no-1-8-v;
	pm-ignore-notify;
	keep-power-in-suspend;
	non-removable;
		
	//max-frequency = <25000000>;
	//max-frequency = <5000000>;
	
	non-removable;
	status = "okay";
};

&wdog3 { /*Needed for clena reboot*/
	status = "okay";
};

&iomuxc {
	pinctrl_eqos: eqosgrp { /*ETHERNET*/
		fsl,pins = <
			MX93_PAD_ENET1_MDC__ENET_QOS_MDC                        0x1e
			MX93_PAD_ENET1_MDIO__ENET_QOS_MDIO                      0x1e
			MX93_PAD_ENET1_RD0__ENET_QOS_RGMII_RD0                  0x1e
			MX93_PAD_ENET1_RD1__ENET_QOS_RGMII_RD1                  0x1e
			MX93_PAD_ENET1_RXC__ENET_QOS_RX_ER						0x1e
			MX93_PAD_ENET1_RX_CTL__ENET_QOS_RGMII_RX_CTL            0x1e
			MX93_PAD_ENET1_TD0__ENET_QOS_RGMII_TD0                  0x1e
			MX93_PAD_ENET1_TD1__ENET_QOS_RGMII_TD1                  0x1e
			MX93_PAD_ENET1_TD2__CCM_ENET_QOS_CLOCK_GENERATE_REF_CLK 0x1e
			MX93_PAD_ENET1_TX_CTL__ENET_QOS_RGMII_TX_CTL            0x1e
			MX93_PAD_PDM_BIT_STREAM1__GPIO1_IO10					0x1e
			/*MX93_PAD_ENET1_RD2__GPIO4_IO12						0x1e*/
		>;
	};
	
	pinctrl_flexcan1: flexcan1grp { /*CAN*/
		fsl,pins = <
			MX93_PAD_PDM_CLK__CAN1_TX			0x139e
			MX93_PAD_PDM_BIT_STREAM0__CAN1_RX	0x139e
		>;
	};

	pinctrl_lpi2c2: lpi2c2grp { /*I2C2*/
		fsl,pins = <
			MX93_PAD_I2C2_SCL__LPI2C2_SCL	0x40000b9e
			MX93_PAD_I2C2_SDA__LPI2C2_SDA	0x40000b9e
		>;
	};

	pinctrl_lpi2c3: lpi2c3grp { /*I2C3*/
		fsl,pins = <
			MX93_PAD_GPIO_IO28__LPI2C3_SDA	0x40000b9e
			MX93_PAD_GPIO_IO29__LPI2C3_SCL	0x40000b9e
		>;
	};

	pinctrl_ilitek: ilitekgrp { /*TOUCSCREEN*/
		fsl,pins = <
			MX93_PAD_ENET2_RXC__GPIO4_IO23	0x1b0b0 /* LCD_TP_nINT */
			MX93_PAD_ENET1_RD2__GPIO4_IO12	0x1b0b0 /* LCD_TP_nRST */
		>;
	};

	pinctrl_lpspi1: lpspi1grp { /*SPI MISO/MOSI*/
		fsl,pins = <
			MX93_PAD_SAI1_TXFS__GPIO1_IO11		0x3fe /* SPI_SS0 */
			MX93_PAD_SAI1_TXC__LPSPI1_SIN		0x3fe /* SPI_MISO */
			MX93_PAD_SAI1_RXD0__LPSPI1_SOUT		0x3fe /* SPI_MOSI */
			MX93_PAD_SAI1_TXD0__LPSPI1_SCK		0x3fe /* SPI_CLK */
			MX93_PAD_ENET1_TD3__GPIO4_IO02		0x3fe /* TPM_RST */
		>;
	};

	pinctrl_pcal6416: pcal6416grp { /*EXPANSION GPIO*/
		fsl,pins = <
			MX93_PAD_ENET2_RD3__GPIO4_IO27			0x31e /* INTERRUPT */
			MX93_PAD_SD1_STROBE__GPIO3_IO18			0x31e /* RESET */
		>;
	};

	pinctrl_pf9453: pf9453grp { /*PMIC*/
		fsl,pins = <
			MX93_PAD_SD2_RESET_B__GPIO3_IO07	0x1e
		>;
	};

	pinctrl_sai2: sai1grp { /*SAI2*/
		fsl,pins = <
			MX93_PAD_ENET2_TX_CTL__SAI2_TX_SYNC		0x31e /*I2S_LRCLK*/
			MX93_PAD_ENET2_RX_CTL__SAI2_TX_DATA00	0x31e /*I2S_DOUT*/
			MX93_PAD_ENET2_TD3__SAI2_RX_DATA00		0x31e /*I2S_DIN*/
			MX93_PAD_ENET2_TXC__SAI2_TX_BCLK		0x31e /*I2S_SCLK*/
			MX93_PAD_CCM_CLKO1__CCMSRCGPCMIX_CLKO1 	0x31e
		>;
	};
	
	pinctrl_sai2_sleep: sai1grpsleep { /*SAI2*/
		fsl,pins = <
			MX93_PAD_ENET2_TXC__GPIO4_IO21		0x51e
			MX93_PAD_ENET2_TX_CTL__GPIO4_IO20	0x51e
			MX93_PAD_ENET2_RX_CTL__GPIO4_IO22	0x51e
			MX93_PAD_ENET2_TD3__GPIO4_IO16		0x51e
		>;
	};

	pinctrl_tas2780_reset: tas2780resetgrp { /*SOUND - Reset*/
        fsl,pins = <
            MX93_PAD_ENET1_RD3__GPIO4_IO13	0x11e  /* AUDIO_SD# */
        >;
    };

	pinctrl_tpm2_ch0: tpm2ch0grp { /*DISPLAY - Backlight PWM*/
		fsl,pins = <
			MX93_PAD_I2C1_SCL__TPM2_CH0	0x31e /*LCD_BKL_PWM*/
		>;
	};

	pinctrl_uart1: uart1grp { /*CONSOLE*/
		fsl,pins = <
			MX93_PAD_UART1_RXD__LPUART1_RX	0x31e
			MX93_PAD_UART1_TXD__LPUART1_TX	0x31e
		>;
	};

	pinctrl_uart2: uart2grp { /*RS 232*/
		fsl,pins = <
			MX93_PAD_UART2_RXD__LPUART2_RX	0x31e
			MX93_PAD_UART2_TXD__LPUART2_TX	0x31e
		>;
	};

	pinctrl_uart4: uart4grp { /*BT*/
		fsl,pins = <
			MX93_PAD_ENET2_RD2__LPUART4_CTS_B	0x31e
			MX93_PAD_ENET2_RD0__LPUART4_RX		0x31e
			MX93_PAD_ENET2_TD0__LPUART4_TX		0x31e
			MX93_PAD_ENET2_TD1__LPUART4_RTS_B	0x31e
		>;
	};

	pinctrl_uart5: uart5grp { /*RS 485*/
		fsl,pins = <
			MX93_PAD_DAP_TDI__LPUART5_RX			0x31e
			MX93_PAD_DAP_TDO_TRACESWO__LPUART5_TX	0x31e
			MX93_PAD_DAP_TMS_SWDIO__LPUART5_RTS_B	0x31e
		>;
	};

	pinctrl_usdhc1: usdhc1grp { /*EMMC*/
		fsl,pins = <
			MX93_PAD_SD1_CLK__USDHC1_CLK		0x15fe
			MX93_PAD_SD1_CMD__USDHC1_CMD		0x13fe
			MX93_PAD_SD1_DATA0__USDHC1_DATA0	0x13fe
			MX93_PAD_SD1_DATA1__USDHC1_DATA1	0x13fe
			MX93_PAD_SD1_DATA2__USDHC1_DATA2	0x13fe
			MX93_PAD_SD1_DATA3__USDHC1_DATA3	0x13fe
			MX93_PAD_SD1_DATA4__USDHC1_DATA4	0x13fe
			MX93_PAD_SD1_DATA5__USDHC1_DATA5	0x13fe
			MX93_PAD_SD1_DATA6__USDHC1_DATA6	0x13fe
			MX93_PAD_SD1_DATA7__USDHC1_DATA7	0x13fe
		>;
	};

	pinctrl_usdhc2: usdhc2grp { /*SD CARD*/
		fsl,pins = <
			MX93_PAD_SD2_CLK__USDHC2_CLK		0x170e
			MX93_PAD_SD2_CMD__USDHC2_CMD		0x130e
			MX93_PAD_SD2_DATA0__USDHC2_DATA0	0x130e
			MX93_PAD_SD2_DATA1__USDHC2_DATA1	0x130e
			MX93_PAD_SD2_DATA2__USDHC2_DATA2	0x130e
			MX93_PAD_SD2_DATA3__USDHC2_DATA3	0x130e
		>;
	};

	pinctrl_usdhc3: usdhc3grp { /*WIFI*/
		fsl,pins = <
			MX93_PAD_SD3_CLK__USDHC3_CLK		0x17fe
			MX93_PAD_SD3_CMD__USDHC3_CMD		0x13fe
			MX93_PAD_SD3_DATA0__USDHC3_DATA0	0x13fe
			MX93_PAD_SD3_DATA1__USDHC3_DATA1	0x13fe
			MX93_PAD_SD3_DATA2__USDHC3_DATA2	0x13fe
			MX93_PAD_SD3_DATA3__USDHC3_DATA3	0x13fe
		>;
	};

	pinctrl_lcdif: lcdifgrp { /*DISPLAY - RGB Data/Sync*/
		fsl,pins = <
			MX93_PAD_GPIO_IO00__MEDIAMIX_DISP_CLK	   	0x31e
			MX93_PAD_GPIO_IO01__MEDIAMIX_DISP_DE    	0x31e
			MX93_PAD_GPIO_IO02__MEDIAMIX_DISP_VSYNC		0x31e
			MX93_PAD_GPIO_IO03__MEDIAMIX_DISP_HSYNC	   	0x31e
			MX93_PAD_GPIO_IO04__MEDIAMIX_DISP_DATA00	0x31e
			MX93_PAD_GPIO_IO05__MEDIAMIX_DISP_DATA01	0x31e
			MX93_PAD_GPIO_IO06__MEDIAMIX_DISP_DATA02	0x31e
			MX93_PAD_GPIO_IO07__MEDIAMIX_DISP_DATA03	0x31e
			MX93_PAD_GPIO_IO08__MEDIAMIX_DISP_DATA04	0x31e
			MX93_PAD_GPIO_IO09__MEDIAMIX_DISP_DATA05	0x31e
			MX93_PAD_GPIO_IO10__MEDIAMIX_DISP_DATA06	0x31e
			MX93_PAD_GPIO_IO11__MEDIAMIX_DISP_DATA07	0x31e
			MX93_PAD_GPIO_IO12__MEDIAMIX_DISP_DATA08	0x31e
			MX93_PAD_GPIO_IO13__MEDIAMIX_DISP_DATA09	0x31e
			MX93_PAD_GPIO_IO14__MEDIAMIX_DISP_DATA10	0x31e
			MX93_PAD_GPIO_IO15__MEDIAMIX_DISP_DATA11	0x31e
			MX93_PAD_GPIO_IO16__MEDIAMIX_DISP_DATA12	0x31e
			MX93_PAD_GPIO_IO17__MEDIAMIX_DISP_DATA13	0x31e
			MX93_PAD_GPIO_IO18__MEDIAMIX_DISP_DATA14	0x31e
			MX93_PAD_GPIO_IO19__MEDIAMIX_DISP_DATA15	0x31e
			MX93_PAD_GPIO_IO20__MEDIAMIX_DISP_DATA16	0x31e
			MX93_PAD_GPIO_IO21__MEDIAMIX_DISP_DATA17	0x31e
			MX93_PAD_GPIO_IO22__MEDIAMIX_DISP_DATA18	0x31e
			MX93_PAD_GPIO_IO23__MEDIAMIX_DISP_DATA19	0x31e
			MX93_PAD_GPIO_IO24__MEDIAMIX_DISP_DATA20	0x31e
			/*MX93_PAD_GPIO_IO25__MEDIAMIX_DISP_DATA21	0x31e DISPLAY ON/OFF */
			MX93_PAD_GPIO_IO26__MEDIAMIX_DISP_DATA22	0x31e
			MX93_PAD_GPIO_IO27__MEDIAMIX_DISP_DATA23	0x31e
		>;
	};
	
	pinctrl_disp_pwr: disppwrgrp { /*DISPLAY - Power*/
		fsl,pins = <
			MX93_PAD_GPIO_IO25__GPIO2_IO25    0x31e /*DISPLAY ON/OFF*/
		>;
	};
	
	pinctrl_lcd_rst: lcdrstgrp { /*DISPLAY - Reset*/
		fsl,pins = <
			MX93_PAD_ENET2_TD2__GPIO4_IO17    0x31e /*LCD_nRST*/
		>;
	};
};

&gpio1 {
	gpio-line-names =
		"", "", "", "", "", "", "", "",
		"", "", "RMII1_nRST", "", "", "", "", "",
		"", "", "", "", "", "", "", "",
		"", "", "", "", "", "", "", "";
		RMII1_nRST { /*ETHERNET - nRsT*/
			gpio-hog;
			gpios = <10 0>;
			output-high;
		};
};

&gpio2 {
	status="okay";
	//pinctrl-names = "default";
