&vpuctrl {
	boot = <&vpu_boot>;
	sram = <&sram1>;
};

&wdog3 {
	status = "okay";
};

&sai3 {
    #sound-dai-cells = <0>;
    pinctrl-names = "default";
    pinctrl-0 = <&pinctrl_sai3>;
    assigned-clocks = <&scmi_clk IMX95_CLK_SAI3>;
    assigned-clock-parents = <&scmi_clk IMX95_CLK_AUDIOPLL1>;
    assigned-clock-rates = <12288000>;
    fsl,sai-mclk-direction-output;
    status = "okay";
};

&gpio1 {
	status = "okay";
	gpio-line-names =
		"", "", "", "", "", "", "", "",
		"", "", "", "enet1_rst_n", "", "enet2_rst_n", "", "",
		"", "", "", "", "", "", "", "",
		"", "", "", "", "", "", "", "";

		pin_enet1_rst_n{
			gpio-hog;
			gpios = <11 0>;
			output-high;
		};

		pin_enet2_rst_n{
			gpio-hog;
			gpios = <13 0>;
			output-high;
		};
};

&gpio2 {
	gpio-line-names =
		"", "", "", "", "", "", "", "",
		"", "", "", "", "", "", "", "",
		"", "", "", "", "", "", "", "",
		"LCD_PWR_EN", "", "", "", "", "", "", "";

	LCD_PWR_EN {
		gpio-hog;
		gpios = <24 0>;
		line-name = "lcd_pwr_en";
		output-high;
	};
};

&gpio3 {
	gpio-line-names =
		"", "", "", "", "", "", "", "",
		"", "", "", "", "", "", "", "",
		"", "", "", "", "", "", "", "",
		"", "", "", "", "", "", "", "";
};

&gpio4 {
	gpio-line-names =
		"", "", "", "", "", "", "", "",
		"", "", "", "", "", "", "", "",
		"", "", "", "", "", "", "", "",
		"", "", "", "", "", "", "", "";

};

&gpio5 {
	gpio-line-names =
		"enet1_mdc", "enet1_mdio", "", "", "", "", "", "",
		"", "", "", "", "", "", "", "",
		"", "", "", "", "", "", "", "",
		"", "", "", "", "", "", "", "";

		ENET1_MDC {
			gpio-hog;
			input;
			gpios = <0 0>;
			line-name = "enet1_mdc";
		};

		ENET1_MDIO {
			gpio-hog;
			input;
			gpios = <1 0>;
			line-name = "enet1_mdio";
			};
};
